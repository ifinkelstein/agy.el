#!/bin/sh
# Forward an agy lifecycle hook to Emacs.
#
# Usage in hooks.json: agy-emacs-hook EVENT   (EVENT such as Stop)
#
# agy writes the hook payload as JSON on stdin and expects JSON on stdout.
# Inside a session started by agy.el, AGY_BUFFER_NAME names the Emacs buffer;
# the payload is handed to `agy-handle-hook' without waiting for Emacs.
# Elsewhere the script does nothing.  It always answers {}, which lets agy
# carry on as if no hook had run.

event=$1
payload=$(cat)

case $event in
  ''|*[!A-Za-z]*) echo '{}'; exit 0 ;;
esac

if [ -n "$AGY_BUFFER_NAME" ]; then
  # Base64-encode arbitrary strings (including multiline JSON) so shell and
  # Elisp string quoting can never break or drop characters.
  b64() { printf '%s' "$1" | base64 | tr -d '\r\n'; }
  emacsclient --no-wait --eval \
    "(agy-handle-hook \"$event\" (decode-coding-string (base64-decode-string \"$(b64 "$AGY_BUFFER_NAME")\") 'utf-8) (decode-coding-string (base64-decode-string \"$(b64 "$payload")\") 'utf-8))" \
    >/dev/null 2>&1
fi

echo '{}'
